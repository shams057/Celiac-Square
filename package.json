{
  "name": "celiac-square",
  "version": "1.0.0",
  "description": "Celiac Square - Plateforme Tunisienne d'Assistance Cœliaque & Sans Gluten",
  "type": "module",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "seed": "cd backend && npm run seed",
    "set-role": "npm run set-role --workspace backend --",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace frontend",
    "test": "npm test --workspace backend",
    "atmc:import": "npm run atmc:import --workspace backend --",
    "artisans:import": "npm run artisans:import --workspace backend --"
  },
  "keywords": [
    "celiac",
    "gluten-free",
    "tunisia",
    "openfoodfacts",
    "computer-vision",
    "react",
    "express"
  ],
  "author": "Celiac Square Team",
  "license": "ISC"
}
