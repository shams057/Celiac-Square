# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Public address of the site, used in password-reset e-mails (add <SITE_URL>/compte/nouveau-mot-de-passe
# to Supabase → Authentication → URL Configuration → Redirect URLs)
SITE_URL=http://localhost:3000

# Other origins allowed to call the API from a browser (comma-separated). Same-origin calls need nothing.
# CORS_ORIGINS=https://celiac-square.vercel.app,http://localhost:3000

# Scanner AI: every provider whose key is set joins the rotation (src/services/aiBalancer.js).
# The gluten verdict is asked to 2-3 of them at once; set at least two keys for that double-check.
# Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=
# OLLAMA_MODEL=gemma4:31b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Groq, free tier (https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# More free tiers, optional:
# MISTRAL_API_KEY=            (https://console.mistral.ai, model mistral-small-latest)
# OPENROUTER_API_KEY=         (https://openrouter.ai/keys)
# OPENROUTER_MODEL=           a model id ending in ":free"; add OPENROUTER_VISION=true if it reads images
# CEREBRAS_API_KEY=           (https://cloud.cerebras.ai, text only)
# CEREBRAS_MODEL=

# OFF_USER_AGENT=CeliacSquare/1.0 (contact@example.com)
PORT=5000
NODE_ENV=development
